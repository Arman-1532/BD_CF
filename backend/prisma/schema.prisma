generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  userId            String          @id @default(uuid()) @map("user_id") @db.VarChar(36)
  displayName       String          @map("display_name") @db.VarChar(100)
  email             String          @unique @db.VarChar(255)
  passwordHash      String          @map("password_hash") @db.VarChar(255)
  role              String          @default("STANDARD") @db.VarChar(50)
  phone             String?         @map("phone_number") @db.VarChar(30)
  status            String          @default("active") @db.VarChar(30)
  isVerified        Boolean         @default(false) @map("is_verified")
  otpCode           String?         @map("otp_code") @db.VarChar(10)
  otpExpiresAt      DateTime?       @map("otp_expires_at") @db.DateTime
  verificationDoc   String?         @map("verification_doc") @db.VarChar(500)
  profilePhotoUrl   String?         @map("profile_photo_url") @db.VarChar(Max)
  bio               String?         @db.VarChar(Max)
  socialLinks       String?         @map("social_links") @db.VarChar(Max)
  payoutDetails     String?         @map("payout_details") @db.VarChar(Max)
  notificationPrefs String?         @map("notification_prefs") @db.VarChar(Max)
  isBlacklisted     Boolean         @default(false) @map("is_blacklisted")
  blacklistedAt     DateTime?       @map("blacklisted_at") @db.DateTime
  blacklistReason   String?         @map("blacklist_reason") @db.VarChar(Max)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.DateTime
  authTokens        AuthToken[]
  campaigns         Campaign[]
  auditLogs         AdminAuditLog[]
  comments          Comment[]
  donations         Donation[]

  @@map("Users")
}

model AuthToken {
  tokenId   Int      @id @default(autoincrement()) @map("token_id")
  userId    String   @map("user_id") @db.VarChar(36)
  tokenHash String   @map("token_hash") @db.VarChar(255)
  type      String   @default("refresh") @db.VarChar(30)
  expiresAt DateTime @map("expires_at") @db.DateTime
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@map("Auth_Tokens")
}

model Campaign {
  id                  String           @id @default(uuid()) @db.VarChar(36)
  title               String           @db.VarChar(200)
  description         String           @db.VarChar(Max)
  category            String           @db.VarChar(100)
  targetAmount        Float            @map("target_amount")
  currentAmount       Float            @default(0) @map("current_amount")
  endDate             DateTime?        @map("end_date") @db.DateTime
  imageData           String           @map("image_data") @db.VarChar(Max)
  imageType           String           @map("image_type") @db.VarChar(50)
  verificationDoc     String?          @map("verification_doc") @db.VarChar(Max)
  verificationDocType String?          @map("verification_doc_type") @db.VarChar(50)
  videoLink           String?          @map("video_link") @db.VarChar(Max)
  location            String?          @db.VarChar(200)
  unionOrWard         String?          @map("union_or_ward") @db.VarChar(100)
  postCode            String?          @map("post_code") @db.VarChar(20)
  status              String           @default("PENDING") @db.VarChar(30)
  takedownReason      String?          @map("takedown_reason") @db.VarChar(Max)
  takenDownAt         DateTime?        @map("taken_down_at") @db.DateTime
  createdById         String           @map("created_by_id") @db.VarChar(36)
  createdAt           DateTime         @default(now()) @map("created_at") @db.DateTime
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.DateTime
  createdBy           User             @relation(fields: [createdById], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  comments            Comment[]
  reports             CampaignReport[]
  donations           Donation[]

  @@map("Campaigns")
}

model Donation {
  id            String   @id @default(uuid()) @db.VarChar(36)
  campaignId    String   @map("campaign_id") @db.VarChar(36)
  userId        String?  @map("user_id") @db.VarChar(36)
  donorName     String   @map("donor_name") @db.VarChar(100)
  isAnonymous   Boolean  @default(false) @map("is_anonymous")
  amount        Float
  paymentRef    String?  @map("payment_ref") @db.VarChar(255)
  status        String   @default("COMPLETED") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User?    @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@map("Donations")
}

model CampaignReport {
  id          String   @id @default(uuid()) @db.VarChar(36)
  campaignId  String   @map("campaign_id") @db.VarChar(36)
  userId      String?  @map("user_id") @db.VarChar(36)
  reason      String   @db.VarChar(Max)
  status      String   @default("PENDING") @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("Campaign_Reports")
}

model Comment {
  id         String   @id @default(uuid()) @db.VarChar(36)
  campaignId String   @map("campaign_id") @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  content    String   @db.VarChar(Max)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user       User     @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@map("Comments")
}

model Category {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime

  @@map("Categories")
}

model AdminAuditLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  adminId   String   @map("admin_id") @db.VarChar(36)
  action    String   @db.VarChar(100)
  targetId  String   @map("target_id") @db.VarChar(36)
  reason    String   @db.VarChar(Max)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime
  admin     User     @relation(fields: [adminId], references: [userId], onDelete: NoAction, onUpdate: NoAction)

  @@map("Admin_Audit_Logs")
}
